// The bubble: a round TV tube with the channel number in a dot matrix and
// the red "on air" light. It is the only thing always visible, so it is where the
// personality lives. Press, "on air" ring and hover come from the app's springs.

import { Palette, Size, Type, Motion } from "tokens.slint";
import { Shadow } from "shadow.slint";

export enum Face { empty, connecting, channel }

export component Bubble inherits Rectangle {
    in property <Face> face: Face.empty;
    in property <string> code;
    // App springs: 0..1 (the "on air" ring overshoots 1 a little on the bounce).
    in property <float> tally;
    in property <float> press;
    // Spinner angle while connecting (the app turns it every frame).
    in property <angle> spin;
    callback pointer-down();
    callback pointer-up();
    callback drag-start();
    callback clicked();

    width: Size.bubble;
    height: Size.bubble;
    property <length> outer: self.width / 2;
    property <float> t: clamp(root.tally, 0, 1.2);

    Rectangle {
        transform-origin: { x: self.width / 2, y: self.height / 2 };
        transform-scale: 1 - (1 - Motion.press-scale) * root.press;

        // Dark shadow for light wallpapers, light halo for dark ones.
        Shadow { width: parent.width; height: parent.height; radius: root.outer; spread: 10px; offset-y: 4px; strength: 0.5; }
        Shadow { width: parent.width; height: parent.height; radius: root.outer; spread: 7px; offset-y: 0; strength: 0.3; tint: Palette.halo; }
        // Device frame: a bit lighter than the room and with a bright rim, so it does not merge with black.
        Rectangle {
            border-radius: root.outer;
            // Solid: the software renderer draws gradients without the rounded corners.
            background: Palette.room-raised.mix(Palette.room, 0.5);
            border-width: Size.rim;
            border-color: touch.has-hover ? Palette.rim-hover : Palette.rim;
            animate border-color { duration: Motion.hover; }
        }
        // Tube glass: scan lines and a highlight at the top.
        Rectangle {
            width: Size.tube;
            height: Size.tube;
            border-radius: self.width / 2;
            clip: true;
            background: Palette.screen;
            // The software renderer clips to a square: scan lines are cut to the
            // circle's width and the highlight stays inside it.
            for i in 17: Rectangle {
                property <length> r: Size.tube / 2;
                property <length> dy: 2px + i * 3px - self.r;
                property <length> half: sqrt(max(0, (self.r * self.r - self.dy * self.dy) / 1px / 1px)) * 1px;
                x: self.r - self.half;
                y: 1.5px + i * 3px;
                width: 2 * self.half;
                height: 1px;
                background: Palette.phosphor.with-alpha(0.035);
            }
            Rectangle {
                x: 6px; y: 4px; width: 26px; height: 26px;
                border-radius: self.width / 2;
                background: Palette.white.with-alpha(0.035);
            }
            if root.face != Face.channel: Rectangle {
                // No channel: a subtle "+" inviting a click.
                Rectangle { width: 14px; height: 2px; border-radius: 1px; background: Palette.phosphor.with-alpha(0.8); }
                Rectangle { width: 2px; height: 14px; border-radius: 1px; background: Palette.phosphor.with-alpha(0.8); }
            }
            if root.face == Face.channel: Text {
                text: root.code;
                font-family: "Doto";
                font-weight: 900;
                font-size: Type.digits-bubble;
                color: Palette.phosphor;
            }
        }
        // Connecting: the app's only spinner, a slow quarter arc around the tube.
        // The software renderer ignores transform-rotation on a Path, so the arc
        // ends are computed from the angle. The angle comes from the app:
        // animation-tick() alone does not ask for new frames there.
        if root.face == Face.connecting: Path {
            property <angle> a: root.spin;
            width: root.width;
            height: root.height;
            viewbox-width: 64;
            viewbox-height: 64;
            stroke: Palette.phosphor;
            stroke-width: 2.5px;
            MoveTo { x: 32 + 29.5 * sin(a); y: 32 - 29.5 * cos(a); }
            ArcTo { x: 32 + 29.5 * sin(a + 90deg); y: 32 - 29.5 * cos(a + 90deg); radius-x: 29.5; radius-y: 29.5; sweep: true; }
        }
        // On air: red ring arriving with a bounce + recording dot.
        if root.tally > 0.01: Rectangle {
            border-radius: root.outer;
            border-width: Size.tally-ring * root.t;
            border-color: Palette.tally.with-alpha(clamp(root.t, 0, 1));
        }
        if root.tally > 0.01: Rectangle {
            x: root.outer + root.outer * 0.68 - 5.5px * root.t;
            y: root.outer - root.outer * 0.68 - 5.5px * root.t;
            width: 11px * root.t;
            height: self.width;
            border-radius: self.width / 2;
            background: Palette.room;
            Rectangle { width: 8px * root.t; height: self.width; border-radius: self.width / 2; background: Palette.tally; }
        }
    }

    // Click opens or closes the menu; dragging (after 4 of movement, so it is not
    // confused with a click) moves the window through the window manager.
    touch := TouchArea {
        mouse-cursor: pointer;
        pointer-event(e) => {
            if e.button == PointerEventButton.left && e.kind == PointerEventKind.down { root.pointer-down(); }
            if e.button == PointerEventButton.left && e.kind == PointerEventKind.up { root.pointer-up(); }
        }
        moved => {
            if self.pressed && (abs(self.mouse-x - self.pressed-x) > 4px || abs(self.mouse-y - self.pressed-y) > 4px) {
                root.drag-start();
            }
        }
        clicked => { root.clicked(); }
    }
}

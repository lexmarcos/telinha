// Botão em pílula. Uma ação principal por painel. Encolhe um pouco no aperto.

import { Palette, Size, Type, Motion } from "tokens.slint";

export enum PillKind { primary, quiet, danger }

export component Pill inherits Rectangle {
    in property <string> label;
    in property <PillKind> kind: PillKind.primary;
    in property <bool> enabled: true;
    callback clicked();

    height: Size.button-h;
    border-radius: self.height / 2;
    background: root.kind == PillKind.primary ? Palette.text : root.kind == PillKind.danger ? Palette.tally : Palette.line;
    opacity: !root.enabled ? 0.45 : touch.has-hover && !touch.pressed ? 0.92 : 1;
    transform-origin: { x: self.width / 2, y: self.height / 2 };
    transform-scale: touch.pressed ? 0.97 : 1;
    animate transform-scale, opacity { duration: Motion.press; }

    touch := TouchArea {
        enabled: root.enabled;
        mouse-cursor: root.enabled ? pointer : default;
        clicked => { root.clicked(); }
    }
    Text {
        text: root.label;
        font-size: Type.body;
        font-weight: Type.semibold;
        color: root.kind == PillKind.primary ? Palette.room : root.kind == PillKind.danger ? Palette.white : Palette.text;
    }
}

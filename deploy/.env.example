# Copy to /opt/telinha/.env on the VPS and fill in. Never commit the .env.
TURN_SECRET=          # openssl rand -hex 32 (the same goes in turnserver.conf)
TURN_HOST=            # site domain, e.g. telinha.example.com
PUBLIC_IP=            # public IP of the VPS (coturn)
PROXY_NETWORK=        # existing Docker network of the reverse proxy (Caddy)
CADDY_CERTS=          # caddy/certificates folder inside the Caddy data volume

# Optional: address of the Discord bot (bot/) as seen from inside the container,
# usually the end of an SSH tunnel on the proxy network's gateway.
# BOT_URL=http://172.18.0.1:8790

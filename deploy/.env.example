# Copie para /opt/telinha/.env na VPS e preencha. Nunca commite o .env.
TURN_SECRET=          # openssl rand -hex 32 (o mesmo vai no turnserver.conf)
TURN_HOST=            # domínio do site, ex.: telinha.exemplo.com
PUBLIC_IP=            # IP público da VPS (coturn)
PROXY_NETWORK=        # rede Docker do proxy reverso (Caddy) que já existe
CADDY_CERTS=          # pasta caddy/certificates dentro do volume de dados do Caddy

# Opcional: endereço do bot do Discord (bot/) visto de dentro do container,
# normalmente a ponta de um túnel SSH no gateway da rede do proxy.
# BOT_URL=http://172.18.0.1:8790
